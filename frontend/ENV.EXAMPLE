# Frontend environment example
# Copy to frontend/.env for local development or add to Vercel environment variables.

VITE_API_URL=http://localhost:8000/api/v1
# Vercel-only (serverless): leave VITE_API_URL UNSET — the app calls same-origin /api/v1 automatically.
# Hybrid (persistent API) production example:
# VITE_API_URL=https://your-api-host.com/api/v1


