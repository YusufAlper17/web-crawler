# Backend environment example
# Copy to backend/.env and adjust values for your environment.

# Database
DATABASE_URL=sqlite:///./webcrawler.db
# DATABASE_URL=postgresql://postgres:postgres@postgres:5432/webcrawler

# Redis
REDIS_URL=redis://localhost:6379/0
# REDIS_URL=redis://redis:6379/0

# API
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000"]

# Crawler tuning
MAX_DEPTH=10
MAX_PAGES=10000
REQUEST_DELAY=1.0
TIMEOUT=30
CONCURRENT_REQUESTS=10
USER_AGENT=WebCrawler/1.0 (+https://example.com/bot)


