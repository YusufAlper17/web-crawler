# Backend environment example
# Copy to backend/.env for local development or define these values in your host.

# App / deploy
APP_NAME=CrawlScope
DEPLOYMENT_TARGET=local
PUBLIC_FRONTEND_URL=http://localhost:3000

# Database
DATABASE_URL=sqlite:///./webcrawler.db
# Production: use managed Postgres, for example Supabase, Railway or Render.
# DATABASE_URL=postgresql://postgres:password@db.example.supabase.co:5432/postgres

# Redis
REDIS_URL=redis://localhost:6379/0
# REDIS_URL=redis://redis:6379/0

# API
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000"]
# Production example (Vercel frontend):
# CORS_ORIGINS=["https://your-vercel-app.vercel.app"]

# Railway example:
# DEPLOYMENT_TARGET=railway
# PUBLIC_FRONTEND_URL=https://your-vercel-app.vercel.app
# DATABASE_URL=${{Postgres.DATABASE_URL}}
# CORS_ORIGINS=["https://your-vercel-app.vercel.app"]

# Crawler tuning
MAX_DEPTH=10
MAX_PAGES=10000
REQUEST_DELAY=1.0
TIMEOUT=30
CONCURRENT_REQUESTS=10
USER_AGENT=WebCrawler/1.0 (+https://example.com/bot)


